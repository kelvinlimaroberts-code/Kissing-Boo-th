      imposterNextLine: 12
      requiresCharge: 0
    - text: I'm gonna rub your lamp
      tone: 
      nextLine: 5
      imposterNextLine: 14
      requiresCharge: 1
    - text: Like you have a chance for a night with me
      tone: 
      nextLine: 10
      imposterNextLine: 16
      requiresCharge: 1
  - text: It's alright. we all get ahead of ourselves sometimes.
    voiceLine: {fileID: 8300000, guid: 5296f665ef5e4bb408674371fe42b39c, type: 3}
    currentEmotion: {fileID: 21300000, guid: e7b6db66fd3f98e45be79efc07a49a6e, type: 3}
    responses:
    - text: Let's start over then
      tone: 
      nextLine: 0
      imposterNextLine: 0
      requiresCharge: 0
    - text: I had a troubled past.
      tone: 
      nextLine: 3
      imposterNextLine: 3
      requiresCharge: 0
  - text: I'm a hungry man but I don't want burger
    voiceLine: {fileID: 8300000, guid: 325c0d02979d5104eba10486115f32bb, type: 3}
